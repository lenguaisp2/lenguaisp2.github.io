        // Generar acordeones del plan
        function generarPlan() {
            const container = document.getElementById('plan-accordion-container');
            let html = '';

            for (let año in planData) {
                const data = planData[año];
                const expanded = año === '1' ? 'expanded' : 'collapsed';
                const toggle = año === '1' ? '▼' : '▶';
                const showClass = año === '1' ? 'show' : '';

                html += `
                    <div class="accordion">
                        <div class="accordion-header ${expanded}" onclick="toggleAccordion(this)">
                            📚 ${data.nombre}
                            <span class="accordion-toggle">${toggle}</span>
                        </div>
                        <div class="accordion-content ${showClass}">
                            <ul class="materia-list">
                                ${data.materias.map(materia => 
                                    `<li><strong>${materia.numero} -</strong> ${materia.nombre}</li>`
                                ).join('')}
                            </ul>
                        </div>
                    </div>
                `;
            }

            container.innerHTML = html;
        }

        // Toggle acordeón
        function toggleAccordion(headerElement) {
            const content = headerElement.nextElementSibling;
            const isExpanded = headerElement.classList.contains('expanded');

            if (isExpanded) {
                headerElement.classList.remove('expanded');
                headerElement.classList.add('collapsed');
                content.classList.remove('show');
                headerElement.querySelector('.accordion-toggle').textContent = '▶';
            } else {
                headerElement.classList.remove('collapsed');
                headerElement.classList.add('expanded');
                content.classList.add('show');
                headerElement.querySelector('.accordion-toggle').textContent = '▼';
            }
        }

        // Scroll a secciones
        function scrollToSection(sectionId) {
            const element = document.getElementById(sectionId);
            if (element) {
                element.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        // Inicializar
        document.addEventListener('DOMContentLoaded', function() {
            generarPlan();
        });
    </script>
</body>
</html>
